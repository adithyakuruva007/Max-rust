[Unit]
Description=Max AI Hardware Agent
Documentation=https://github.com/max/max
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@@RPI_USER@@
SupplementaryGroups=gpio spi i2c
WorkingDirectory=/home/@@RPI_USER@@/max
ExecStart=/home/@@RPI_USER@@/max/max gateway start
Restart=on-failure
RestartSec=5
EnvironmentFile=/home/@@RPI_USER@@/max/.env
Environment=RUST_LOG=info

# Expand ~ in config path
Environment=HOME=/home/@@RPI_USER@@

[Install]
WantedBy=multi-user.target
